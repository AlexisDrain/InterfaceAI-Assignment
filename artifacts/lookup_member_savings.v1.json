      "name": "teller_id",
      "type": "string",
      "description": "input parameter 'teller_id'",
      "required": true,
      "sensitive": false
    },
    {
      "name": "access_code",
      "type": "string",
      "description": "input parameter 'access_code'",
      "required": true,
      "sensitive": true
    },
    {
      "name": "member_id",
      "type": "string",
      "description": "input parameter 'member_id'",
      "required": true,
      "sensitive": false
    }
  ],
  "outputs": [
    {
      "name": "savings_balance",
      "type": "string",
      "description": "Current balance of the member's Savings account",
      "extract": {
        "description": "",
        "strategies": [
          {
            "kind": "row_cell",
            "row_text": "Savings",
            "column_header": "Current Balance"
          }
        ]
      }
    }
  ],
  "steps": [
