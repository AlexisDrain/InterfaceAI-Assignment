{
  "schema_version": "1.0",
  "capability_id": "lookup_member_savings",
  "name": "Lookup Member Savings",
  "description": "Sign in to the teller portal, look up the member by member number, and read their current Savings account balance.",
  "version": 1,
  "status": "approved",
  "base_url": "http://127.0.0.1:8300",
