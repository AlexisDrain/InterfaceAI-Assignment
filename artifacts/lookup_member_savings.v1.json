        "description": "Enter teller ID",
        "strategies": [
          {
            "kind": "role",
            "role": "textbox",
            "name": "Teller ID"
          },
          {
            "kind": "css",
            "selector": "input[name=\"teller\"]"
          },
          {
            "kind": "css",
            "selector": "form > table > tbody > tr:nth-of-type(1) > td:nth-of-type(2) > input"
          }
        ]
      },
      "value": "{{teller_id}}",
      "wait_after": {
        "load_state": "load"
      }
    },
    {
      "id": "s3",
      "action": "type",
      "note": "Enter access code",
